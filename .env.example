# Copia questo file in .env e inserisci i tuoi dati.
# .env non viene versionato (vedi .gitignore).

# Credenziali database
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=

# Password di amministratore (per setup/reset.php).
# Lasciandola vuota l'accesso di amministratore è disabilitato.
ADMIN_PASSWORD=
